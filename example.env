# ==============================================================================
# AI Assistant Environment Configuration Template
# ==============================================================================

# LLM Credentials (Google Gemini)
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Web Search Tool Credentials (Tavily)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Neon PostgreSQL pooled connection string (copy from the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Qdrant Cloud cluster URL and database API key are required.
# e.g., QDRANT_ENDPOINT=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_ENDPOINT=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
# Optional alternate remote URL; QDRANT_ENDPOINT takes precedence.
QDRANT_URL=
QDRANT_COLLECTION_NAME=ai-assistant-collection
QDRANT_DENSE_DATATYPE=float32

# Model Configurations
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_4BIT=true

# Google sign-in (OAuth web application credentials)
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# Add this exact URI to the Google Cloud OAuth client's authorized redirect URIs.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_random_session_secret
SESSION_HTTPS_ONLY=false

# RAG & Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DISTANCE_METRIC=Cosine
TOP_K=10
TOP_N=3

# LLM Generation Parameters
TEMPERATURE=1

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
