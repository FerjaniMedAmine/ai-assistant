# ==============================================================================
# AI Assistant Environment Configuration Template
# ==============================================================================

# LLM Credentials (Google Gemini)
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Web Search Tool Credentials (Tavily)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_assistant
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_assistant

# Qdrant Vector Database Configuration (Qdrant Cloud or Local)
# For Qdrant Cloud cluster, set QDRANT_ENDPOINT and QDRANT_API_KEY:
# e.g., QDRANT_ENDPOINT=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_ENDPOINT=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
# Fallback / local URL if not using QDRANT_ENDPOINT
QDRANT_URL=
QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION_NAME=ai-assistant-collection

# Model Configurations
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# RAG & Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DISTANCE_METRIC=Cosine
TOP_K=10
TOP_N=3

# LLM Generation Parameters
TEMPERATURE=0.7

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
